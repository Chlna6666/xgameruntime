; SPDX-License-Identifier: LGPL-2.1-or-later
; Export ordinals follow WineGDK dlls/xgameruntime/xgameruntime.spec.
; The LIBRARY directive is intentionally omitted because it is equivalent to
; /DLL and can leak into Rust test harness linking. Cargo already selects the
; DLL output kind for the cdylib target.

EXPORTS
    DllCanUnloadNow @1
    DllGetClassObject
    InitializeApiImpl @2
    InitializeApiImplEx @3
    InitializeApiImplEx2 @4
    QueryApiImpl @5
    UninitializeApiImpl @6
    XErrorReport @7
    XGameRuntimeInitialize @8
    XGameRuntimeUninitialize @9
